{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    // Language
    "target": "ES2022",
    "lib": ["ES2022"],
    // Module
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // Paths
    "rootDir": "./src",
    "outDir": "./dist",
    // Output
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Interop
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
