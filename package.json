{
  "name": "typescript-template",
  "version": "1.0.0",
  "description": "Template for TypeScript projects",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "vp lint --fix .",
    "format": "vp fmt .",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  }
}
